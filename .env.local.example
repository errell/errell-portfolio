# Copy to .env.local for local dev.
# On Vercel: Project Settings → Environment Variables (Production + Preview).
# Never commit real values.

# Resend — https://resend.com (required for contact form email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=uxtap@outlook.com

# Must be a Resend-verified domain/sender.
# Sandbox for testing: Portfolio Contact <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Public site key. Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key. Server only. Do not prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Password required to open a case study. Server only. Leave empty to keep studies locked.
CASE_STUDY_PASSWORD=
